# ===== 若依后端 =====
RUOYI_BASE_URL=http://127.0.0.1:8087
RUOYI_USERNAME=admin
RUOYI_PASSWORD=admin123

# ===== LLM 开关（默认关闭：纯检索+模板）=====
LLM_ENABLED=false
# 可选：deepseek / openai / tongyi / kimi / zhipu / ollama / custom
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# ===== 服务 =====
AGENT_HOST=127.0.0.1
AGENT_PORT=8099